{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "dockerfileContext": "backend"
  },
  "deploy": {
    "startCommand": "python app.py",
    "healthcheckPath": "/api/jobs/",
    "restartPolicyType": "ON_FAILURE"
  }
}
